NODE_ENV=production
TITAN_BIND_ADDRESS=0.0.0.0
TITAN_PORT=1200
TITAN_BASE_URL=http://localhost:1200
TITAN_PROJECT_DIR=/project-titan
TITAN_DATA_DIR=./storage
TITAN_UPLOAD_DIR=/app/uploads
COOKIE_SECURE=false
POSTGRES_USER=titan
POSTGRES_DB=titan
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://titan:replace-with-a-long-random-secret@postgres:5432/titan?schema=public
REDIS_URL=redis://redis:6379
MINIO_ACCESS_KEY=titan-storage
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_PORT=9001
AUTH_SECRET=replace-with-at-least-64-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-64-random-characters
TITAN_UPDATE_TOKEN=replace-with-at-least-64-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-on-first-install
TITAN_UPDATE_BRANCH=main
TITAN_GIT_REPOSITORY=https://github.com/jrmediagroupvan/Project-Titan.git
OPENROUTER_API_KEY=
OPENAI_API_KEY=
BAMBUBUDDY_BASE_URL=http://host.docker.internal:8000
TITAN_UPDATER_URL=http://updater:8787
